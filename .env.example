# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored and will never be committed.
#
# SmartMaps tile API key (https://smartmaps.net)
# The key is embedded in the built JS bundle and therefore public.
# Restrict it to your domain in the SmartMaps dashboard.
VITE_SMARTMAPS_API_KEY=your_smartmaps_api_key_here
